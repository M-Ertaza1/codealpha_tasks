# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file to GitHub (it's already in .gitignore).

# Get a free connection string from MongoDB Atlas (cloud.mongodb.com)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/basecamp_store

# Any long random string works for local dev. Change it for production.
JWT_SECRET=your_long_random_secret_string_here

# Port the backend server runs on
PORT=5000
