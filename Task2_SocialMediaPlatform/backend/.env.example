# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file to GitHub (it's already in .gitignore).

# You can reuse the SAME MongoDB Atlas cluster from Task 1 — just point
# to a different database name so the data doesn't mix with your store.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fieldnote_social

# Any long random string works for local dev. Change it for production.
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Port the backend server runs on. Different from Task 1 (5000) so you
# can run both projects at the same time if you want to.
PORT=5001
